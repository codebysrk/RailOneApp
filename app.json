{
  "expo": {
    "name": "RailOne",
    "slug": "RailOne",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.railone.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#0066ff",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "dark",
          "backgroundColor": "#ffffff",
          "translucent": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "dark-content",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-system-ui",
        {
          "userInterfaceStyle": "light"
        }
      ]
    ]
  }
}
