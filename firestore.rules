rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile & subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /tickets/{ticketId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /wallet_ledger/{txnId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /passengers/{passengerId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Global Master Collections (Public Read)
    match /stations/{stationCode} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /trains/{trainNumber} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /pnr_records/{pnr} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
