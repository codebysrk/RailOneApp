rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: User is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Request is made by the resource owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: User has active Admin role in database
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // --- Users Collection ------------------------------------------
    match /users/{userId} {
      // Admin can read all users; User can read only their own profile
      allow read: if isOwner(userId) || isAdmin();

      // New users can only be created with role == 'user' and status == 'active'
      allow create: if (isOwner(userId) &&
        request.resource.data.role == 'user' &&
        request.resource.data.status == 'active') || isAdmin();

      // Users can update basic profile data (displayName, mobile) but cannot escalate role or change status
      allow update: if (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'uid'])) || isAdmin();

      // Only Admins can delete users
      allow delete: if isAdmin();

      // Wallet Ledger Subcollection
      match /wallet_ledger/{txnId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // --- Bookings Collection (Top-Level) ---------------------------
    match /bookings/{bookingId} {
      // Users can read only their own bookings; Admins can read all bookings
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();

      // Users can create bookings only under their own UID
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();

      // Users can update only their own bookings (e.g. cancellation); Admins can update any
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();

      // Only Admins can delete booking records
      allow delete: if isAdmin();
    }

    // --- Reference Masters (Stations & Trains) ----------------------
    match /stations/{stationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /trains/{trainId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Auxiliary User Collections (Tickets, Notifications, Feedback)
    match /tickets/{ticketId} {
      allow read, write, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow read, write, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /feedback/{feedbackId} {
      allow read, write, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // --- Deleted Users Audit Logs ----------------------------------
    match /deleted_users/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
